###> symfony/framework-bundle ###
APP_ENV=prod
APP_SECRET=replace_with_random_32_chars_secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8080
###< symfony/routing ###

###> homelabstatus configuration ###
APP_NAME="Homelab Status"
ADMIN_PASSWORD=change_this_secure_password
API_KEY=

# SQLite Database storage path (defaults inside var/data)
DB_PATH="%kernel.project_dir%/var/data/homelabstatus.sqlite"

# Host metrics collection
ENABLE_HOST_METRICS=true

# Notification Integrations (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GENERIC_WEBHOOK_URL=
###< homelabstatus configuration ###
