{% extends 'admin/layout.html.twig' %}

{% block title %}{{ isEdit ? 'Edit Check' : 'Create Check' }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-extrabold text-white">{{ isEdit ? 'Edit Check: ' ~ check.name : 'Create New Monitored Check' }}</h1>
            <p class="text-xs text-zinc-400 mt-1">Configure probe settings, target IP/URL, and classification criteria.</p>
        </div>
        <a href="/admin/checks" class="text-xs font-mono text-zinc-400 hover:text-white">← Back to Checks</a>
    </div>

    <form method="POST" class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 space-y-5">
        <div class="space-y-4">
            <div>
                <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Check Name</label>
                <input type="text" name="name" value="{{ check ? check.name : '' }}" required placeholder="e.g. Cloudflare Web Portal or Primary Gateway" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Check Type</label>
                    <select name="type" id="check_type" onchange="toggleTypeFields(this.value)" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                        <option value="uplink" {% if not check or check.type == 'uplink' %}selected{% endif %}>uplink (Multi-Packet Anycast Ping)</option>
                        <option value="http" {% if check and check.type == 'http' %}selected{% endif %}>http / https (Web Endpoint & SSL)</option>
                        <option value="icmp_ping" {% if check and check.type == 'icmp_ping' %}selected{% endif %}>icmp_ping (Single Host Ping)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Target Host / IP / URL</label>
                    <input type="text" name="host" value="{{ check ? (check.config.url|default(check.config.host|default(''))) : '' }}" required placeholder="e.g. 1.1.1.1 or https://example.com" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs font-mono text-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Group Name</label>
                    <input type="text" name="group_name" value="{{ check ? check.groupName : 'Web Endpoints' }}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Provider / Label</label>
                    <input type="text" name="provider" value="{{ check ? check.config.provider|default('Cloudflare') : 'Cloudflare' }}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
            </div>

            <!-- HTTP-Specific Fields -->
            <div id="http_fields" class="p-4 bg-zinc-950/60 border border-zinc-800/80 rounded-xl space-y-4 {% if not check or check.type != 'http' %}hidden{% endif %}">
                <div class="text-[11px] font-mono text-emerald-400 font-bold uppercase">HTTP Configuration</div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Expected HTTP Status Code</label>
                        <input type="number" name="expected_status" value="{{ check ? check.config.expected_status|default(200) : 200 }}" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs font-mono text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-zinc-300 mb-1.5">HTTP Method</label>
                        <select name="method" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                            <option value="GET" {% if not check or check.config.method|default('GET') == 'GET' %}selected{% endif %}>GET</option>
                            <option value="HEAD" {% if check and check.config.method|default('') == 'HEAD' %}selected{% endif %}>HEAD</option>
                            <option value="POST" {% if check and check.config.method|default('') == 'POST' %}selected{% endif %}>POST</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Keyword Match in Response (Optional)</label>
                    <input type="text" name="keyword" value="{{ check ? check.config.keyword|default('') : '' }}" placeholder="String required in response body" class="w-full bg-zinc-900 border border-zinc-800 rounded-xl px-3.5 py-2 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
            </div>

            <!-- General / Timing Fields -->
            <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Interval (sec)</label>
                    <input type="number" name="interval" min="5" max="86400" value="{{ check ? check.interval : 60 }}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs font-mono text-emerald-400 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Packets (Ping)</label>
                    <input type="number" name="packets" min="1" max="10" value="{{ check ? check.config.packets|default(2) : 2 }}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs font-mono text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Timeout (sec)</label>
                    <input type="number" name="timeout" min="1" max="30" value="{{ check ? check.config.timeout|default(5) : 5 }}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs font-mono text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Sort Order</label>
                    <input type="number" name="sort_order" value="{{ check ? check.sortOrder : 10 }}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs font-mono text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-zinc-300 mb-1.5">Description (Optional)</label>
                <textarea name="description" rows="2" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-emerald-500">{{ check ? check.description : '' }}</textarea>
            </div>

            <div class="flex items-center gap-2 pt-2">
                <input type="checkbox" id="is_enabled" name="is_enabled" value="1" {% if not check or check.isEnabled %}checked{% endif %} class="rounded bg-zinc-950 border-zinc-800 text-emerald-500 focus:ring-emerald-500">
                <label for="is_enabled" class="text-xs font-semibold text-zinc-200">Enable check immediately</label>
            </div>
        </div>

        <div class="pt-4 border-t border-zinc-800 flex items-center justify-between">
            <a href="/admin/checks" class="text-xs font-semibold text-zinc-400 hover:text-white">Cancel</a>
            <button type="submit" class="px-5 py-2.5 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition shadow-lg shadow-emerald-950">
                {{ isEdit ? 'Save Changes' : 'Create Check' }}
            </button>
        </div>
    </form>
</div>

<script>
    function toggleTypeFields(type) {
        const httpFields = document.getElementById('http_fields');
        if (type === 'http' || type === 'https') {
            httpFields.classList.remove('hidden');
        } else {
            httpFields.classList.add('hidden');
        }
    }
</script>
{% endblock %}
