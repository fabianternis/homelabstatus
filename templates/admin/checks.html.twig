{% extends 'admin/layout.html.twig' %}

{% block title %}Checks Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header & Filter Tabs -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-extrabold text-white">Monitored Checks</h1>
            <p class="text-xs text-zinc-400 mt-1">Configure external resolvers, endpoints, and targets with dynamic JSON configurations.</p>
        </div>

        <div class="flex items-center gap-2">
            <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-1 flex items-center gap-1 text-xs font-semibold">
                <a href="?filter=all" class="px-3 py-1.5 rounded-lg {% if filter == 'all' %}bg-zinc-800 text-white{% else %}text-zinc-400 hover:text-white{% endif %}">Active ({{ totalActive }})</a>
                <a href="?filter=trashed" class="px-3 py-1.5 rounded-lg {% if filter == 'trashed' %}bg-rose-500/20 text-rose-400{% else %}text-zinc-400 hover:text-white{% endif %}">Trash ({{ totalTrashed }})</a>
            </div>
            <a href="/admin/checks/create" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-lg shadow-emerald-950">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                Create Check
            </a>
        </div>
    </div>

    <!-- Mass Actions Form & Table -->
    <form id="bulk-form" action="/admin/checks/bulk-action" method="POST">
        <input type="hidden" name="filter" value="{{ filter }}">

        <!-- Floating Bulk Action Toolbar (appears when items are selected) -->
        <div id="bulk-toolbar" class="hidden sticky top-20 z-40 mb-4 p-3.5 bg-zinc-900/95 backdrop-blur border border-emerald-500/40 rounded-2xl shadow-2xl flex flex-wrap items-center justify-between gap-3 animate-fade-in">
            <div class="flex items-center gap-3">
                <div class="w-7 h-7 rounded-lg bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                </div>
                <span class="text-xs font-bold text-white"><span id="selected-count" class="font-mono text-emerald-400">0</span> checks selected</span>
            </div>

            <div class="flex items-center gap-2">
                {% if filter != 'trashed' %}
                    <button type="submit" name="action" value="enable" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition">
                        Enable Selected
                    </button>
                    <button type="submit" name="action" value="disable" class="px-3 py-1.5 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded-lg text-xs font-bold transition">
                        Disable Selected
                    </button>
                    <button type="submit" name="action" value="trash" onclick="return confirm('Move selected checks to trash?')" class="px-3 py-1.5 bg-rose-600/20 hover:bg-rose-600/30 text-rose-400 border border-rose-500/30 rounded-lg text-xs font-bold transition">
                        Trash Selected
                    </button>
                {% else %}
                    <button type="submit" name="action" value="restore" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-xs font-bold transition">
                        Restore Selected
                    </button>
                    <button type="submit" name="action" value="force_delete" onclick="return confirm('Permanently destroy selected checks? This cannot be undone.')" class="px-3 py-1.5 bg-rose-600 hover:bg-rose-500 text-white rounded-lg text-xs font-bold transition">
                        Permanently Delete Selected
                    </button>
                {% endif %}

                <button type="button" onclick="deselectAll()" class="px-2.5 py-1.5 text-zinc-400 hover:text-white text-xs transition">
                    Deselect All
                </button>
            </div>
        </div>

        <!-- Checks Table -->
        <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-zinc-800 text-zinc-500 font-mono">
                            <th class="pb-3 w-8">
                                <input type="checkbox" id="select-all-checks" onchange="toggleSelectAll(this.checked)" class="rounded bg-zinc-950 border-zinc-800 text-emerald-500 focus:ring-emerald-500 cursor-pointer">
                            </th>
                            <th class="pb-3">Name / ULID</th>
                            <th class="pb-3">Target Host</th>
                            <th class="pb-3">Type & Group</th>
                            <th class="pb-3">Interval</th>
                            <th class="pb-3">Enabled</th>
                            <th class="pb-3">Status</th>
                            <th class="pb-3">Latency</th>
                            <th class="pb-3">Loss</th>
                            <th class="pb-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/50">
                        {% for check in checks %}
                            <tr class="hover:bg-zinc-800/20 transition">
                                <td class="py-3.5">
                                    <input type="checkbox" name="check_ids[]" value="{{ check.id }}" onchange="updateSelectedCount()" class="check-item-checkbox rounded bg-zinc-950 border-zinc-800 text-emerald-500 focus:ring-emerald-500 cursor-pointer">
                                </td>
                                <td class="py-3.5 font-semibold text-white">
                                    {{ check.name }}
                                    <div class="text-[10px] text-zinc-500 font-mono">{{ check.id }}</div>
                                </td>
                                <td class="py-3.5 font-mono text-zinc-300">{{ check.config.url|default(check.config.host|default('-')) }}</td>
                                <td class="py-3.5 text-zinc-400 font-mono">
                                    <span class="px-2 py-0.5 bg-zinc-800 rounded">{{ check.type }}</span>
                                    <div class="text-[10px] text-zinc-500 font-sans mt-0.5">{{ check.groupName }}</div>
                                </td>
                                <td class="py-3.5 font-mono text-emerald-400 font-semibold">{{ check.interval }}s</td>
                                <td class="py-3.5">
                                    {% if check.isTrashed() %}
                                        <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-rose-500/20 text-rose-400">Trashed</span>
                                    {% else %}
                                        <span class="px-2.5 py-1 rounded text-[10px] font-bold uppercase {% if check.isEnabled %}bg-emerald-500/20 text-emerald-400{% else %}bg-zinc-800 text-zinc-400{% endif %}">
                                            {{ check.isEnabled ? 'Enabled' : 'Disabled' }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="py-3.5">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase {% if check.status.value == 'excellent' or check.status.value == 'good' %}bg-emerald-500/15 text-emerald-400 border border-emerald-500/30{% else %}bg-amber-500/15 text-amber-400 border border-amber-500/30{% endif %}">
                                        {{ check.status.value }}
                                    </span>
                                </td>
                                <td class="py-3.5 font-mono font-bold text-white">
                                    {% if check.lastMetrics.avg_latency_ms is defined and check.lastMetrics.avg_latency_ms is not null %}
                                        {{ check.lastMetrics.avg_latency_ms|round(1) }} ms
                                    {% elseif check.lastMetrics.duration_ms is defined and check.lastMetrics.duration_ms is not null %}
                                        {{ check.lastMetrics.duration_ms|round(1) }} ms
                                    {% else %}
                                        -
                                    {% endif %}
                                </td>
                                <td class="py-3.5 font-mono {% if (check.lastMetrics.packet_loss_percent|default(0)) == 0 %}text-emerald-400{% else %}text-rose-400{% endif %}">
                                    {{ check.lastMetrics.packet_loss_percent|default(0)|round(0) }}%
                                </td>
                                <td class="py-3.5 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        {% if check.isTrashed() %}
                                            <a href="/admin/checks/{{ check.id }}/edit" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded font-semibold text-xs transition">Edit</a>
                                        {% else %}
                                            <a href="/admin/checks/{{ check.id }}/edit" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 rounded font-semibold text-xs transition">Edit</a>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="py-8 text-center text-zinc-500">No checks found for the selected filter.</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </form>
</div>

<script>
    function updateSelectedCount() {
        const checkboxes = document.querySelectorAll('.check-item-checkbox:checked');
        const count = checkboxes.length;
        const toolbar = document.getElementById('bulk-toolbar');
        const countEl = document.getElementById('selected-count');
        const selectAllBox = document.getElementById('select-all-checks');

        countEl.textContent = count;

        if (count > 0) {
            toolbar.classList.remove('hidden');
        } else {
            toolbar.classList.add('hidden');
        }

        const allCheckboxes = document.querySelectorAll('.check-item-checkbox');
        if (allCheckboxes.length > 0) {
            selectAllBox.checked = checkboxes.length === allCheckboxes.length;
            selectAllBox.indeterminate = count > 0 && count < allCheckboxes.length;
        }
    }

    function toggleSelectAll(isChecked) {
        const checkboxes = document.querySelectorAll('.check-item-checkbox');
        checkboxes.forEach(cb => cb.checked = isChecked);
        updateSelectedCount();
    }

    function deselectAll() {
        toggleSelectAll(false);
    }
</script>
{% endblock %}
