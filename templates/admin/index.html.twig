{% extends 'base.html.twig' %}

{% block title %}Admin Management Portal — {{ appName }}{% endblock %}

{% block body %}
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <h1 class="text-2xl font-extrabold text-white tracking-tight">Admin Console</h1>
        <p class="text-xs text-zinc-400 mt-1">Configure services, endpoints, incidents, and test checks live.</p>
    </div>
    <div class="flex items-center gap-3">
        <a href="{{ path('dashboard_index') }}" class="px-3.5 py-1.5 rounded-lg border border-zinc-700 bg-zinc-800 text-xs font-semibold text-zinc-300 hover:text-white transition">
            View Public Dashboard
        </a>
        <a href="{{ path('admin_logout') }}" class="px-3.5 py-1.5 rounded-lg border border-rose-500/30 bg-rose-500/10 text-xs font-semibold text-rose-300 hover:bg-rose-500/20 transition">
            Logout
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Left Column: Add Monitor & Incident Forms -->
    <div class="space-y-8 lg:col-span-1">
        <!-- New Monitor Form -->
        <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
            <h2 class="text-base font-bold text-white mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                Add Monitored Target
            </h2>

            <form method="POST" action="{{ path('admin_store_monitor') }}" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Service Name</label>
                    <input type="text" name="name" required placeholder="e.g. Proxmox VE, Pi-hole DNS" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white placeholder-zinc-600 focus:border-emerald-500 outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Group Category</label>
                        <input type="text" name="group_name" placeholder="Services, Core Network..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white placeholder-zinc-600 focus:border-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Check Type</label>
                        <select name="type" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-white focus:border-emerald-500 outline-none">
                            {% for type in checkTypes %}
                                <option value="{{ type.value }}">{{ type.label() }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Target Endpoint / Host</label>
                    <input type="text" name="target" required placeholder="https://..., 192.168.1.1:8080, or container name" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white font-mono placeholder-zinc-600 focus:border-emerald-500 outline-none">
                </div>

                <div>
                    <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Description (Optional)</label>
                    <input type="text" name="description" placeholder="Brief note about this node" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white placeholder-zinc-600 focus:border-emerald-500 outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Timeout (Seconds)</label>
                        <input type="number" name="timeout_seconds" value="5" min="1" max="30" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white font-mono focus:border-emerald-500 outline-none">
                    </div>
                    <div>
                        <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Expected HTTP Code</label>
                        <input type="number" name="expected_status_code" value="200" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white font-mono focus:border-emerald-500 outline-none">
                    </div>
                </div>

                <div>
                    <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Keyword Match (Optional)</label>
                    <input type="text" name="keyword" placeholder="String expected in response body" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white placeholder-zinc-600 focus:border-emerald-500 outline-none">
                </div>

                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" name="is_private" id="is_private" value="1" class="rounded bg-zinc-950 border-zinc-800 text-emerald-500 focus:ring-emerald-500">
                    <label for="is_private" class="text-zinc-400 font-medium">Private Monitor (Hide from public status page)</label>
                </div>

                <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-2 px-4 rounded-xl text-xs transition shadow-lg shadow-emerald-950/40">
                    Save & Test Target
                </button>
            </form>
        </div>

        <!-- Post Incident Notice -->
        <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
            <h2 class="text-base font-bold text-white mb-4 flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                Post Incident / Maintenance
            </h2>

            <form method="POST" action="{{ path('admin_store_incident') }}" class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Incident Headline</label>
                    <input type="text" name="title" required placeholder="e.g. Fiber Link Flapping, Node Maintenance" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white placeholder-zinc-600 focus:border-amber-500 outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Severity</label>
                        <select name="severity" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-white focus:border-amber-500 outline-none">
                            <option value="info">Info / Maintenance</option>
                            <option value="warning" selected>Degraded Performance</option>
                            <option value="critical">Critical Outage</option>
                        </select>
                    </div>
                    <div>
                        <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Affected Monitor</label>
                        <select name="monitor_id" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-white focus:border-amber-500 outline-none">
                            <option value="">(All / General Homelab)</option>
                            {% for m in monitors %}
                                <option value="{{ m.id }}">{{ m.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-semibold uppercase tracking-wider text-zinc-400 mb-1">Details & Context</label>
                    <textarea name="message" rows="3" required placeholder="Explain the root cause or planned maintenance window..." class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2 text-white placeholder-zinc-600 focus:border-amber-500 outline-none"></textarea>
                </div>

                <button type="submit" class="w-full bg-amber-600 hover:bg-amber-500 text-white font-bold py-2 px-4 rounded-xl text-xs transition shadow-lg shadow-amber-950/40">
                    Publish Incident Notice
                </button>
            </form>
        </div>
    </div>

    <!-- Right Column: Active Monitors List & Controls -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Active Incidents Management (if any) -->
        {% if incidents is not empty %}
            <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
                <h2 class="text-sm font-bold uppercase tracking-wider text-rose-400 mb-4">Open Incidents</h2>
                <div class="space-y-3">
                    {% for inc in incidents %}
                        <div class="p-4 bg-zinc-950/60 border border-rose-500/30 rounded-xl flex items-center justify-between gap-4">
                            <div>
                                <div class="font-bold text-white text-sm">{{ inc.title }}</div>
                                <div class="text-xs text-zinc-400 mt-1">{{ inc.message }}</div>
                            </div>
                            <form method="POST" action="{{ path('admin_resolve_incident', {id: inc.id}) }}">
                                <button type="submit" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-semibold rounded-lg transition whitespace-nowrap">
                                    Mark Resolved
                                </button>
                            </form>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}

        <!-- Monitors Table -->
        <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
            <h2 class="text-base font-bold text-white mb-4">Configured Monitors ({{ monitors|length }})</h2>
            
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-zinc-800 text-zinc-500">
                            <th class="pb-3">Service</th>
                            <th class="pb-3">Type / Target</th>
                            <th class="pb-3">Status</th>
                            <th class="pb-3">Latency</th>
                            <th class="pb-3 text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-zinc-800/50">
                        {% for m in monitors %}
                            <tr class="hover:bg-zinc-800/20" id="monitor-row-{{ m.id }}">
                                <td class="py-3 font-semibold text-white">
                                    {{ m.name }}
                                    <div class="text-[10px] text-zinc-500 font-normal">{{ m.groupName }} {% if m.isPrivate %}<span class="text-amber-400">(Private)</span>{% endif %}</div>
                                </td>
                                <td class="py-3 font-mono text-zinc-400">
                                    <span class="text-zinc-500">[{{ m.type.value|upper }}]</span>
                                    <span class="truncate inline-block max-w-[160px] align-bottom">{{ m.target }}</span>
                                </td>
                                <td class="py-3">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold border {{ m.status.badgeClasses() }}" id="status-badge-{{ m.id }}">
                                        {{ m.status.value|upper }}
                                    </span>
                                </td>
                                <td class="py-3 font-mono text-zinc-300" id="latency-{{ m.id }}">
                                    {{ m.lastResponseTimeMs|round(1) }} ms
                                </td>
                                <td class="py-3 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <button onclick="testMonitor({{ m.id }})" id="test-btn-{{ m.id }}" class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-[11px] font-medium rounded-lg transition">
                                            Test Now
                                        </button>
                                        <form method="POST" action="{{ path('admin_delete_monitor', {id: m.id}) }}" onsubmit="return confirm('Are you sure you want to delete this monitor?');">
                                            <button type="submit" class="px-2.5 py-1 bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 text-[11px] font-medium rounded-lg transition border border-rose-500/20">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="py-6 text-center text-zinc-500">No monitors configured. Use the form on the left to add one!</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
async function testMonitor(id) {
    const btn = document.getElementById('test-btn-' + id);
    const badge = document.getElementById('status-badge-' + id);
    const latency = document.getElementById('latency-' + id);

    btn.disabled = true;
    btn.textContent = 'Testing...';

    try {
        const res = await fetch('/admin/monitors/' + id + '/check', {
            method: 'POST',
            headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        const data = await res.json();
        
        if (data.status === 'ok') {
            latency.textContent = data.result.response_time_ms + ' ms';
            badge.textContent = data.result.status.toUpperCase();
            
            if (data.result.status === 'online') {
                badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold border bg-emerald-500/15 text-emerald-400 border-emerald-500/30';
            } else if (data.result.status === 'degraded') {
                badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold border bg-amber-500/15 text-amber-400 border-amber-500/30';
            } else {
                badge.className = 'px-2 py-0.5 rounded text-[10px] font-bold border bg-rose-500/15 text-rose-400 border-rose-500/30';
            }
        }
    } catch (e) {
        alert('Check failed: ' + e);
    } finally {
        btn.disabled = false;
        btn.textContent = 'Test Now';
    }
}
</script>
{% endblock %}
