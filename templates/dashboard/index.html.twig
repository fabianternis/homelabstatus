{% extends 'base.html.twig' %}

{% block title %}{{ appName }} — System Health & Status{% endblock %}

{% block body %}
<!-- Top Status Hero Banner -->
<div class="mb-8 rounded-2xl p-6 sm:p-8 border transition-all duration-300 {% if summary.status.value == 'online' %}bg-gradient-to-br from-emerald-950/40 via-zinc-900/50 to-zinc-900 border-emerald-500/30{% elseif summary.status.value == 'degraded' %}bg-gradient-to-br from-amber-950/40 via-zinc-900/50 to-zinc-900 border-amber-500/30{% else %}bg-gradient-to-br from-rose-950/40 via-zinc-900/50 to-zinc-900 border-rose-500/30{% endif %}">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center border shadow-lg {% if summary.status.value == 'online' %}bg-emerald-500/20 text-emerald-400 border-emerald-500/40 shadow-emerald-900/20{% elseif summary.status.value == 'degraded' %}bg-amber-500/20 text-amber-400 border-amber-500/40 shadow-amber-900/20{% else %}bg-rose-500/20 text-rose-400 border-rose-500/40 shadow-rose-900/20{% endif %}">
                {% if summary.status.value == 'online' %}
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                    </svg>
                {% elseif summary.status.value == 'degraded' %}
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                {% else %}
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                {% endif %}
            </div>
            <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white">
                    {% if summary.status.value == 'online' %}
                        All Systems Operational
                    {% elseif summary.status.value == 'degraded' %}
                        Some Systems Experiencing Degraded Performance
                    {% else %}
                        System Outage Detected
                    {% endif %}
                </h1>
                <p class="text-sm text-zinc-400 mt-1">
                    {{ summary.online_count }} of {{ summary.total_count }} services currently operational • Updated <span class="font-mono text-zinc-300">{{ lastUpdated }}</span>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 self-start md:self-auto">
            <div class="bg-zinc-900/90 border border-zinc-800 px-4 py-2.5 rounded-xl text-right">
                <div class="text-[11px] uppercase tracking-wider text-zinc-400 font-semibold">Overall SLA</div>
                <div class="text-xl font-mono font-bold text-emerald-400">{{ summary.system_uptime }}%</div>
            </div>
        </div>
    </div>
</div>

<!-- Active Incidents Banner (if any) -->
{% if activeIncidents is not empty %}
    <div class="mb-8 space-y-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-rose-400 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-rose-500 animate-ping"></span>
            Active Incidents
        </h2>
        {% for incident in activeIncidents %}
            <div class="bg-rose-950/30 border border-rose-500/40 rounded-xl p-5 text-rose-100">
                <div class="flex items-start justify-between gap-4">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 text-xs font-semibold rounded bg-rose-500/20 text-rose-300 border border-rose-500/30 uppercase">
                                {{ incident.severity.label() }}
                            </span>
                            <h3 class="font-bold text-white text-base">{{ incident.title }}</h3>
                        </div>
                        <p class="text-sm text-zinc-300 mt-2">{{ incident.message }}</p>
                        <div class="text-xs text-zinc-400 mt-3 font-mono">
                            Started: {{ incident.startedAt }} {% if incident.monitorName %}• Service: {{ incident.monitorName }}{% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}

<!-- Host System Vitals (Hardware / Resources) -->
{% if systemMetrics %}
<div class="mb-10 bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
    <div class="flex items-center justify-between mb-4">
        <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-400 flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
            </svg>
            Host Node Vitals
        </h2>
        <span class="text-xs font-mono text-zinc-500">Load Avg: {{ systemMetrics.load1m }}, {{ systemMetrics.load5m }}, {{ systemMetrics.load15m }}</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- CPU -->
        <div class="bg-zinc-950/60 border border-zinc-800/70 p-4 rounded-xl">
            <div class="flex justify-between items-center text-xs mb-2">
                <span class="text-zinc-400 font-medium">CPU Utilization</span>
                <span class="font-mono font-bold {% if systemMetrics.cpuUsagePercent > 80 %}text-rose-400{% elseif systemMetrics.cpuUsagePercent > 60 %}text-amber-400{% else %}text-emerald-400{% endif %}">
                    {{ systemMetrics.cpuUsagePercent }}%
                </span>
            </div>
            <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
                <div class="h-2 rounded-full transition-all duration-500 {% if systemMetrics.cpuUsagePercent > 80 %}bg-rose-500{% elseif systemMetrics.cpuUsagePercent > 60 %}bg-amber-500{% else %}bg-emerald-500{% endif %}" style="width: {{ systemMetrics.cpuUsagePercent }}%"></div>
            </div>
        </div>

        <!-- RAM -->
        {% set ramPercent = systemMetrics.memoryTotalBytes > 0 ? (systemMetrics.memoryUsedBytes / systemMetrics.memoryTotalBytes * 100)|round(1) : 0 %}
        <div class="bg-zinc-950/60 border border-zinc-800/70 p-4 rounded-xl">
            <div class="flex justify-between items-center text-xs mb-2">
                <span class="text-zinc-400 font-medium">Memory Usage</span>
                <span class="font-mono font-bold {% if ramPercent > 85 %}text-rose-400{% elseif ramPercent > 70 %}text-amber-400{% else %}text-emerald-400{% endif %}">
                    {{ ramPercent }}%
                </span>
            </div>
            <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
                <div class="h-2 rounded-full transition-all duration-500 {% if ramPercent > 85 %}bg-rose-500{% elseif ramPercent > 70 %}bg-amber-500{% else %}bg-emerald-500{% endif %}" style="width: {{ ramPercent }}%"></div>
            </div>
        </div>

        <!-- Disk -->
        {% set diskPercent = systemMetrics.diskTotalBytes > 0 ? (systemMetrics.diskUsedBytes / systemMetrics.diskTotalBytes * 100)|round(1) : 0 %}
        <div class="bg-zinc-950/60 border border-zinc-800/70 p-4 rounded-xl">
            <div class="flex justify-between items-center text-xs mb-2">
                <span class="text-zinc-400 font-medium">Disk Volume</span>
                <span class="font-mono font-bold {% if diskPercent > 90 %}text-rose-400{% elseif diskPercent > 75 %}text-amber-400{% else %}text-emerald-400{% endif %}">
                    {{ diskPercent }}%
                </span>
            </div>
            <div class="w-full bg-zinc-800 rounded-full h-2 overflow-hidden">
                <div class="h-2 rounded-full transition-all duration-500 {% if diskPercent > 90 %}bg-rose-500{% elseif diskPercent > 75 %}bg-amber-500{% else %}bg-emerald-500{% endif %}" style="width: {{ diskPercent }}%"></div>
            </div>
        </div>
    </div>
</div>
{% endif %}

<!-- Monitored Services by Group -->
<div class="space-y-10">
    {% for groupName, monitors in groupedMonitors %}
        <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-zinc-800/80 pb-2">
                <h2 class="text-lg font-bold text-white tracking-tight flex items-center gap-2">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                    {{ groupName }}
                </h2>
                <span class="text-xs text-zinc-500 font-mono">{{ monitors|length }} monitors</span>
            </div>

            <div class="grid grid-cols-1 gap-4">
                {% for monitor in monitors %}
                    {% set upt = uptimeData[monitor.id]|default({'30d': 100, 'avg_latency': 0}) %}
                    {% set daily = historyData[monitor.id]|default([]) %}
                    <div class="bg-zinc-900/60 border border-zinc-800/80 hover:border-zinc-700/80 transition rounded-2xl p-5">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                            <!-- Service Info -->
                            <div>
                                <div class="flex items-center gap-2.5">
                                    <a href="{{ path('dashboard_show', {id: monitor.id}) }}" class="text-base font-bold text-white hover:text-emerald-400 transition">
                                        {{ monitor.name }}
                                    </a>
                                    <span class="px-2.5 py-0.5 text-xs font-semibold rounded-full border {{ monitor.status.badgeClasses() }}">
                                        {{ monitor.status.label() }}
                                    </span>
                                </div>
                                {% if monitor.description %}
                                    <p class="text-xs text-zinc-400 mt-1">{{ monitor.description }}</p>
                                {% endif %}
                                <div class="flex items-center gap-3 text-xs text-zinc-500 font-mono mt-2">
                                    <span>Type: {{ monitor.type.label() }}</span>
                                    <span>•</span>
                                    <span>Latency: <strong class="text-zinc-300">{{ monitor.lastResponseTimeMs|round(1) }} ms</strong></span>
                                </div>
                            </div>

                            <!-- 30-Day Uptime Percentage -->
                            <div class="text-right">
                                <div class="text-xs text-zinc-400 font-medium">30 days uptime</div>
                                <div class="text-lg font-mono font-bold {% if upt['30d'] >= 99 %}text-emerald-400{% elseif upt['30d'] >= 95 %}text-amber-400{% else %}text-rose-400{% endif %}">
                                    {{ upt['30d'] }}%
                                </div>
                            </div>
                        </div>

                        <!-- 30 Days Status Bars -->
                        <div class="mt-4 pt-3 border-t border-zinc-800/50">
                            <div class="flex items-center gap-1 w-full h-7">
                                {% for day in daily %}
                                    <div class="flex-1 h-6 rounded-sm transition hover:scale-110 cursor-pointer relative group {% if day.status == 'online' %}bg-emerald-500/80 hover:bg-emerald-400{% elseif day.status == 'degraded' %}bg-amber-500/80 hover:bg-amber-400{% else %}bg-rose-500/80 hover:bg-rose-400{% endif %}" title="{{ day.date }}: {{ day.uptime }}% uptime ({{ day.avg_latency }}ms)">
                                        <!-- Tooltip -->
                                        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-50 whitespace-nowrap bg-zinc-900 border border-zinc-700 text-white text-[10px] px-2 py-1 rounded shadow-lg pointer-events-none">
                                            {{ day.date }}: {{ day.uptime }}%
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="flex justify-between items-center text-[10px] text-zinc-500 font-mono mt-1.5">
                                <span>30 days ago</span>
                                <span>Today</span>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        <div class="text-center py-16 bg-zinc-900/40 border border-zinc-800 rounded-2xl">
            <p class="text-zinc-400 text-base mb-4">No monitors configured yet.</p>
            <a href="{{ path('admin_index') }}" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-sm rounded-xl transition">
                Add Your First Service
            </a>
        </div>
    {% endfor %}
</div>

<!-- Recent Incidents History -->
{% if recentIncidents is not empty %}
    <div class="mt-16 pt-8 border-t border-zinc-800">
        <h2 class="text-lg font-bold text-white tracking-tight mb-6">Past Incidents & Maintenance</h2>
        <div class="space-y-4">
            {% for incident in recentIncidents %}
                <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                    <div>
                        <div class="flex items-center gap-2">
                            <span class="px-2 py-0.5 text-[11px] font-semibold rounded bg-zinc-800 text-zinc-300 border border-zinc-700">
                                {{ incident.status|capitalize }}
                            </span>
                            <span class="font-bold text-white text-sm">{{ incident.title }}</span>
                        </div>
                        <p class="text-xs text-zinc-400 mt-1">{{ incident.message }}</p>
                    </div>
                    <div class="text-right text-xs text-zinc-500 font-mono">
                        {{ incident.startedAt }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endif %}
{% endblock %}

{% block javascripts %}
<script>
    // Auto-refresh every 60 seconds
    setTimeout(() => {
        window.location.reload();
    }, 60000);
</script>
{% endblock %}
