{% extends 'base.html.twig' %}

{% block title %}{{ monitor.name }} — Status Details{% endblock %}

{% block body %}
<div class="mb-6">
    <a href="{{ path('dashboard_index') }}" class="text-xs font-semibold text-zinc-400 hover:text-white inline-flex items-center gap-1.5 transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Back to Dashboard
    </a>
</div>

<!-- Header Card -->
<div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 sm:p-8 mb-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">{{ monitor.name }}</h1>
                <span class="px-3 py-1 text-xs font-semibold rounded-full border {{ monitor.status.badgeClasses() }}">
                    {{ monitor.status.label() }}
                </span>
            </div>
            {% if monitor.description %}
                <p class="text-sm text-zinc-400 mt-2">{{ monitor.description }}</p>
            {% endif %}
            <div class="flex flex-wrap gap-4 text-xs font-mono text-zinc-500 mt-4">
                <span>Group: <strong class="text-zinc-300">{{ monitor.groupName }}</strong></span>
                <span>•</span>
                <span>Type: <strong class="text-zinc-300">{{ monitor.type.label() }}</strong></span>
                <span>•</span>
                <span>Target: <strong class="text-zinc-300">{{ monitor.target }}</strong></span>
                <span>•</span>
                <span>Interval: <strong class="text-zinc-300">{{ monitor.intervalSeconds }}s</strong></span>
            </div>
        </div>

        <div class="flex sm:flex-col items-center sm:items-end justify-between gap-1 bg-zinc-950/60 p-4 rounded-xl border border-zinc-800">
            <div class="text-xs text-zinc-400">Current Latency</div>
            <div class="text-2xl font-mono font-bold text-emerald-400">{{ monitor.lastResponseTimeMs|round(1) }} ms</div>
        </div>
    </div>
</div>

<!-- Uptime Stats Grid -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
    <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 text-center">
        <div class="text-xs text-zinc-400 font-medium">Last 24 Hours</div>
        <div class="text-xl font-mono font-bold mt-1 {% if uptimes['24h'] >= 99 %}text-emerald-400{% elseif uptimes['24h'] >= 95 %}text-amber-400{% else %}text-rose-400{% endif %}">
            {{ uptimes['24h'] }}%
        </div>
    </div>
    <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 text-center">
        <div class="text-xs text-zinc-400 font-medium">Last 7 Days</div>
        <div class="text-xl font-mono font-bold mt-1 {% if uptimes['7d'] >= 99 %}text-emerald-400{% elseif uptimes['7d'] >= 95 %}text-amber-400{% else %}text-rose-400{% endif %}">
            {{ uptimes['7d'] }}%
        </div>
    </div>
    <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 text-center">
        <div class="text-xs text-zinc-400 font-medium">Last 30 Days</div>
        <div class="text-xl font-mono font-bold mt-1 {% if uptimes['30d'] >= 99 %}text-emerald-400{% elseif uptimes['30d'] >= 95 %}text-amber-400{% else %}text-rose-400{% endif %}">
            {{ uptimes['30d'] }}%
        </div>
    </div>
    <div class="bg-zinc-900/40 border border-zinc-800/80 rounded-xl p-4 text-center">
        <div class="text-xs text-zinc-400 font-medium">Last 90 Days</div>
        <div class="text-xl font-mono font-bold mt-1 {% if uptimes['90d'] >= 99 %}text-emerald-400{% elseif uptimes['90d'] >= 95 %}text-amber-400{% else %}text-rose-400{% endif %}">
            {{ uptimes['90d'] }}%
        </div>
    </div>
</div>

<!-- 60 Days Uptime Graph -->
<div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6 mb-8">
    <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-400 mb-4">60-Day Availability & Latency History</h2>
    <div class="flex items-center gap-1 w-full h-12">
        {% for day in dailyHistory %}
            <div class="flex-1 h-10 rounded-sm transition hover:scale-110 cursor-pointer relative group {% if day.status == 'online' %}bg-emerald-500/80 hover:bg-emerald-400{% elseif day.status == 'degraded' %}bg-amber-500/80 hover:bg-amber-400{% else %}bg-rose-500/80 hover:bg-rose-400{% endif %}" title="{{ day.date }}: {{ day.uptime }}% ({{ day.avg_latency }}ms)">
                <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block z-50 whitespace-nowrap bg-zinc-900 border border-zinc-700 text-white text-[10px] px-2 py-1 rounded shadow-lg pointer-events-none">
                    {{ day.date }}: {{ day.uptime }}% ({{ day.avg_latency }}ms)
                </div>
            </div>
        {% endfor %}
    </div>
    <div class="flex justify-between items-center text-xs text-zinc-500 font-mono mt-2">
        <span>60 days ago</span>
        <span>Today</span>
    </div>
</div>

<!-- Recent Checks Table -->
<div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
    <h2 class="text-sm font-bold uppercase tracking-wider text-zinc-400 mb-4">Recent Check Logs (Last 50)</h2>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs font-mono">
            <thead>
                <tr class="border-b border-zinc-800 text-zinc-500">
                    <th class="pb-3">Timestamp</th>
                    <th class="pb-3">Status</th>
                    <th class="pb-3">Response Time</th>
                    <th class="pb-3">Details</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/50">
                {% for check in recentChecks|reverse %}
                    <tr class="hover:bg-zinc-800/20">
                        <td class="py-2.5 text-zinc-400">{{ check.checked_at }}</td>
                        <td class="py-2.5">
                            <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase {% if check.status == 'online' %}bg-emerald-500/20 text-emerald-400{% elseif check.status == 'degraded' %}bg-amber-500/20 text-amber-400{% else %}bg-rose-500/20 text-rose-400{% endif %}">
                                {{ check.status }}
                            </span>
                        </td>
                        <td class="py-2.5 text-zinc-300">{{ check.response_time_ms }} ms</td>
                        <td class="py-2.5 text-zinc-500">{{ check.error_message|default('OK') }}</td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="py-4 text-center text-zinc-500">No recent check records found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
