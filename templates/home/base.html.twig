<!DOCTYPE html>
<html lang="{{ locale }}" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'app.title'|trans }}{% endblock %} — Homelab</title>
    
    <!-- PWA & Meta Tags -->
    <link rel="manifest" href="/manifest.json">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="theme-color" content="#10b981">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Homelab">

    <!-- Tailwind & Chart.js -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        .blur-ip {
            filter: blur(5px);
            transition: filter 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
        }
        .blur-ip:hover {
            filter: blur(0);
            user-select: text;
        }

        @keyframes pulse-highlight {
            0% {
                background-color: rgba(16, 185, 129, 0.25);
                color: #34d399;
                border-radius: 4px;
            }
            100% {
                background-color: transparent;
            }
        }
        .live-updated {
            animation: pulse-highlight 0.9s ease-out;
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-white">
    <!-- Header -->
    <header class="border-b border-zinc-800/80 bg-zinc-900/60 backdrop-blur sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-6">
                <a href="/" class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div>
                        <span class="font-bold text-lg text-white tracking-tight">Homelab <span class="text-emerald-400">Status</span></span>
                    </div>
                </a>

                <!-- Navigation Tabs -->
                <nav class="hidden md:flex items-center gap-1 text-xs font-semibold">
                    <a href="/" class="px-3 py-2 rounded-lg transition {% if activeTab == 'overview' %}bg-zinc-800 text-emerald-400 border border-zinc-700/60{% else %}text-zinc-400 hover:text-white hover:bg-zinc-800/60{% endif %}">
                        Dashboard
                    </a>
                    <a href="/uplink" class="px-3 py-2 rounded-lg transition {% if activeTab == 'uplink' %}bg-zinc-800 text-emerald-400 border border-zinc-700/60{% else %}text-zinc-400 hover:text-white hover:bg-zinc-800/60{% endif %}">
                        Uplink (WAN)
                    </a>
                    <a href="/http" class="px-3 py-2 rounded-lg transition {% if activeTab == 'http' %}bg-zinc-800 text-emerald-400 border border-zinc-700/60{% else %}text-zinc-400 hover:text-white hover:bg-zinc-800/60{% endif %}">
                        HTTP Services
                    </a>
                    <a href="/admin" class="px-3 py-2 rounded-lg text-zinc-400 hover:text-white hover:bg-zinc-800/60 transition">
                        Admin ⚙
                    </a>
                </nav>
            </div>

            <div class="flex items-center gap-3 text-xs font-mono">
                <!-- Dynamic Language Switcher Dropdown -->
                <div class="relative inline-block">
                    <select onchange="window.location.href='?lang=' + this.value" class="bg-zinc-900 border border-zinc-800 hover:border-zinc-700 text-zinc-300 text-xs font-semibold rounded-lg pl-3 pr-8 py-1.5 focus:outline-none focus:ring-1 focus:ring-emerald-500 cursor-pointer appearance-none transition">
                        {% for code, loc in availableLocales %}
                            <option value="{{ code }}" {% if locale == code %}selected{% endif %}>
                                {{ loc.native_name }} ({{ code|upper }})
                            </option>
                        {% endfor %}
                    </select>
                    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-zinc-500">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </div>
                </div>

                <!-- IP Address (Blurred by default, hover to reveal) -->
                <div class="hidden lg:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs" title="{{ 'app.hover_ip'|trans }}">
                    <span class="text-zinc-500 font-sans text-[11px]">{{ 'app.ip_label'|trans }}</span>
                    <span class="blur-ip font-mono text-zinc-200 font-semibold cursor-pointer px-1 py-0.5 bg-zinc-950/80 rounded border border-zinc-800/60">
                        {{ clientIp|default('127.0.0.1') }}
                    </span>
                </div>

                <!-- Live indicator -->
                <div id="connection-badge" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400">
                    <span id="connection-dot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="connection-text">{{ 'app.connecting'|trans }}</span>
                </div>

                <button id="toggle-live-btn" onclick="toggleLiveStream()" class="px-2.5 py-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[11px] font-semibold transition">
                    {{ 'app.pause'|trans }}
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Block -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-8 space-y-8">
        {% block content %}{% endblock %}
    </main>

    <footer class="border-t border-zinc-800/80 bg-zinc-900/30 py-6 text-center text-xs text-zinc-500 font-mono">
        Homelab Status Engine • API-First • Real-time Monitoring
    </footer>

    <!-- Service Worker Registration -->
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js')
                    .then(reg => console.log('SW registered:', reg.scope))
                    .catch(err => console.warn('SW registration skipped:', err));
            });
        }
    </script>
    {% block scripts %}{% endblock %}
</body>
</html>
