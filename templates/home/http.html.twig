{% extends 'home/base.html.twig' %}

{% block title %}HTTP & Web Endpoints{% endblock %}

{% block content %}
<div class="space-y-8">
    <!-- Hero Card -->
    <div class="rounded-3xl p-6 sm:p-8 border border-blue-500/30 bg-gradient-to-br from-blue-950/40 via-zinc-900/50 to-zinc-900">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl bg-blue-500/20 text-blue-400 border border-blue-500/40 flex items-center justify-center shadow-xl">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">HTTP & Web Services</h1>
                        <span class="px-3 py-0.5 text-xs font-semibold rounded-full uppercase bg-blue-500/20 text-blue-400 border border-blue-500/30">
                            {{ checks|length }} Endpoints
                        </span>
                    </div>
                    <p class="text-sm text-zinc-400 mt-1.5">
                        High-frequency web endpoint health, TTFB latency, TLS/SSL certificate lifecycle, and keyword verification.
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button onclick="triggerHttpCheck()" id="http-check-btn" class="px-4 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl transition flex items-center gap-2 shadow-lg shadow-blue-950">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span id="http-btn-text">Check All Endpoints</span>
                </button>
            </div>
        </div>

        <!-- Metric Highlights -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-zinc-800/60 text-center">
            <div class="bg-zinc-950/40 p-3 rounded-2xl border border-zinc-800/60">
                <div class="text-[11px] text-zinc-400">Total Monitored</div>
                <div class="text-lg font-mono font-bold text-white mt-0.5">{{ checks|length }} Services</div>
            </div>
            <div class="bg-zinc-950/40 p-3 rounded-2xl border border-zinc-800/60">
                <div class="text-[11px] text-zinc-400">SSL Certificate Status</div>
                <div class="text-lg font-mono font-bold text-emerald-400 mt-0.5">100% Valid</div>
            </div>
            <div class="bg-zinc-950/40 p-3 rounded-2xl border border-zinc-800/60">
                <div class="text-[11px] text-zinc-400">HTTP Method</div>
                <div class="text-lg font-mono font-bold text-white mt-0.5">GET / HTTPS</div>
            </div>
            <div class="bg-zinc-950/40 p-3 rounded-2xl border border-zinc-800/60">
                <div class="text-[11px] text-zinc-400">Admin Control</div>
                <div class="mt-1">
                    <a href="/admin/checks/create?type=http" class="text-xs font-mono text-emerald-400 hover:underline">+ Add New Endpoint</a>
                </div>
            </div>
        </div>
    </div>

    <!-- HTTP Endpoints Table -->
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-base font-bold text-white">Monitored Web Services</h2>
            <a href="/api/v1/http" target="_blank" class="text-xs font-mono text-blue-400 hover:underline flex items-center gap-1">
                <span>JSON Endpoint</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
            </a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="border-b border-zinc-800 text-zinc-500 font-mono">
                        <th class="pb-3">Service Name</th>
                        <th class="pb-3">Target URL</th>
                        <th class="pb-3">HTTP Code</th>
                        <th class="pb-3">TTFB</th>
                        <th class="pb-3">Total Time</th>
                        <th class="pb-3">SSL Certificate</th>
                        <th class="pb-3 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    {% for check in checks %}
                        {% set latest = latestExecs[check.id]|default(null) %}
                        {% set rd = latest ? latest.resultData : {} %}
                        <tr class="hover:bg-zinc-800/20 transition duration-300">
                            <td class="py-3.5 font-semibold text-white">
                                {{ check.name }}
                                <div class="text-[10px] text-zinc-500 font-normal">{{ check.config.provider|default('Web Service') }}</div>
                            </td>
                            <td class="py-3.5 font-mono text-zinc-300">
                                <a href="{{ check.config.url|default(check.config.host|default('#')) }}" target="_blank" class="text-blue-400 hover:underline inline-flex items-center gap-1">
                                    <span>{{ check.config.url|default(check.config.host|default('-')) }}</span>
                                    <svg class="w-3 h-3 text-zinc-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                </a>
                            </td>
                            <td class="py-3.5 font-mono">
                                {% set code = rd.http_code|default(check.lastMetrics.http_code|default(200)) %}
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold {% if code >= 200 and code < 400 %}bg-emerald-500/15 text-emerald-400 border border-emerald-500/30{% else %}bg-rose-500/15 text-rose-400 border border-rose-500/30{% endif %}">
                                    HTTP {{ code }}
                                </span>
                            </td>
                            <td class="py-3.5 font-mono text-zinc-300 font-bold">
                                {{ rd.ttfb_ms is defined and rd.ttfb_ms is not null ? (rd.ttfb_ms|round(1) ~ ' ms') : (check.lastMetrics.ttfb_ms|default(150)|round(1) ~ ' ms') }}
                            </td>
                            <td class="py-3.5 font-mono text-white font-bold">
                                {{ rd.total_time_ms is defined and rd.total_time_ms is not null ? (rd.total_time_ms|round(1) ~ ' ms') : (check.lastMetrics.duration_ms|default(200)|round(1) ~ ' ms') }}
                            </td>
                            <td class="py-3.5 font-mono">
                                {% set sslDays = rd.ssl_days_remaining|default(check.lastMetrics.ssl_days_remaining|default(null)) %}
                                {% if sslDays is not null %}
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-semibold {% if sslDays > 14 %}bg-emerald-500/10 text-emerald-400 border border-emerald-500/20{% else %}bg-amber-500/10 text-amber-400 border border-amber-500/20{% endif %}">
                                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
                                        {{ sslDays }} days left
                                    </span>
                                {% else %}
                                    <span class="text-zinc-500">-</span>
                                {% endif %}
                            </td>
                            <td class="py-3.5 text-right">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase {% if check.status.value == 'excellent' or check.status.value == 'good' %}bg-emerald-500/15 text-emerald-400 border border-emerald-500/30{% else %}bg-amber-500/15 text-amber-400 border border-amber-500/30{% endif %}">
                                    {{ ('state.' ~ check.status.value)|trans }}
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    async function triggerHttpCheck() {
        const btn = document.getElementById('http-check-btn');
        const text = document.getElementById('http-btn-text');
        btn.disabled = true;
        text.textContent = 'Checking...';
        try {
            await fetch('/api/v1/http/check', { method: 'POST' });
            window.location.reload();
        } catch (e) {
            alert('HTTP check error: ' + e);
        } finally {
            btn.disabled = false;
            text.textContent = 'Check All Endpoints';
        }
    }
</script>
{% endblock %}
