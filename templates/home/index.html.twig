{% extends 'home/base.html.twig' %}

{% block title %}Dashboard Overview{% endblock %}

{% block content %}
<div class="space-y-8">
    <!-- Main Global Status Hero -->
    <div id="hero-card" class="rounded-3xl p-6 sm:p-8 border transition-all duration-500 {% if uplinkStatus.state.value == 'excellent' or uplinkStatus.state.value == 'good' %}bg-gradient-to-br from-emerald-950/40 via-zinc-900/50 to-zinc-900 border-emerald-500/30{% elseif uplinkStatus.state.value == 'degraded' %}bg-gradient-to-br from-amber-950/40 via-zinc-900/50 to-zinc-900 border-amber-500/30{% else %}bg-gradient-to-br from-rose-950/40 via-zinc-900/50 to-zinc-900 border-rose-500/30{% endif %}">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex items-center gap-5">
                <div class="w-16 h-16 rounded-2xl flex items-center justify-center border shadow-xl {% if uplinkStatus.state.value == 'excellent' or uplinkStatus.state.value == 'good' %}bg-emerald-500/20 text-emerald-400 border-emerald-500/40{% elseif uplinkStatus.state.value == 'degraded' %}bg-amber-500/20 text-amber-400 border-amber-500/40{% else %}bg-rose-500/20 text-rose-400 border-rose-500/40{% endif %}">
                    <svg class="w-9 h-9" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                    </svg>
                </div>
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">All Systems Operational</h1>
                        <span id="hero-state-badge" class="px-3 py-0.5 text-xs font-semibold rounded-full uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
                            {{ uplinkStatus.state.value }}
                        </span>
                    </div>
                    <p class="text-sm text-zinc-400 mt-1.5">
                        Monitoring <span class="font-bold text-white font-mono">{{ allChecks|length }}</span> services across WAN Uplink & Web Endpoints • Evaluated <span id="hero-evaluated-time" class="font-mono text-zinc-300">{{ uplinkStatus.evaluatedAt|date('H:i:s T') }}</span>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-4">
                <button onclick="triggerImmediateProbe()" id="probe-btn" class="px-4 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition flex items-center gap-2 shadow-lg shadow-emerald-950">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                    </svg>
                    <span id="probe-btn-text">Probe All Services</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Category Highlights Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Uplink WAN Card -->
        <a href="/uplink" class="p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 hover:border-emerald-500/40 transition group block space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-white group-hover:text-emerald-400 transition">Uplink (WAN) Quality</h2>
                        <p class="text-xs text-zinc-400">{{ uplinkStatus.healthyTargetsCount }}/{{ uplinkStatus.activeTargetsCount }} external Anycast targets healthy</p>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-xs font-mono text-zinc-500 uppercase">Score</div>
                    <div class="text-xl font-bold font-mono text-emerald-400"><span id="hero-score">{{ uplinkStatus.healthScore }}</span><span class="text-xs text-zinc-500">/100</span></div>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-2 pt-2 text-center text-xs">
                <div class="p-2.5 bg-zinc-950/60 rounded-xl border border-zinc-800/60">
                    <div class="text-[10px] text-zinc-500 uppercase font-mono">Avg Latency</div>
                    <div id="vital-latency" class="font-bold text-white font-mono mt-0.5">{{ uplinkStatus.avgLatencyMs|round(1) }} ms</div>
                </div>
                <div class="p-2.5 bg-zinc-950/60 rounded-xl border border-zinc-800/60">
                    <div class="text-[10px] text-zinc-500 uppercase font-mono">Packet Loss</div>
                    <div id="vital-loss" class="font-bold font-mono mt-0.5 {% if uplinkStatus.avgPacketLossPercent == 0 %}text-emerald-400{% else %}text-amber-400{% endif %}">{{ uplinkStatus.avgPacketLossPercent|round(1) }}%</div>
                </div>
                <div class="p-2.5 bg-zinc-950/60 rounded-xl border border-zinc-800/60">
                    <div class="text-[10px] text-zinc-500 uppercase font-mono">Jitter</div>
                    <div id="vital-jitter" class="font-bold text-white font-mono mt-0.5">±{{ uplinkStatus.avgJitterMs|round(1) }} ms</div>
                </div>
            </div>

            <div class="text-xs font-mono text-emerald-400 flex items-center justify-end gap-1 pt-1">
                View Uplink Details & Sparklines →
            </div>
        </a>

        <!-- HTTP Services Card -->
        <a href="/http" class="p-6 rounded-2xl bg-zinc-900/60 border border-zinc-800/80 hover:border-emerald-500/40 transition group block space-y-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-blue-500/10 border border-blue-500/30 flex items-center justify-center text-blue-400">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path>
                        </svg>
                    </div>
                    <div>
                        <h2 class="text-base font-bold text-white group-hover:text-blue-400 transition">HTTP & Web Endpoints</h2>
                        <p class="text-xs text-zinc-400">{{ httpChecks|length }} monitored endpoints with TLS/SSL tracking</p>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-xs font-mono text-zinc-500 uppercase">Status</div>
                    <div class="text-xs font-bold uppercase px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-400 border border-emerald-500/30 mt-1">Healthy</div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-2 pt-2 text-center text-xs">
                <div class="p-2.5 bg-zinc-950/60 rounded-xl border border-zinc-800/60">
                    <div class="text-[10px] text-zinc-500 uppercase font-mono">Web Services</div>
                    <div class="font-bold text-white font-mono mt-0.5">{{ httpChecks|length }} Active</div>
                </div>
                <div class="p-2.5 bg-zinc-950/60 rounded-xl border border-zinc-800/60">
                    <div class="text-[10px] text-zinc-500 uppercase font-mono">SSL Certificates</div>
                    <div class="font-bold text-emerald-400 font-mono mt-0.5">100% Valid</div>
                </div>
            </div>

            <div class="text-xs font-mono text-blue-400 flex items-center justify-end gap-1 pt-1">
                View HTTP Endpoints & SSL Details →
            </div>
        </a>
    </div>

    <!-- Unified Services Status Table -->
    <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h2 class="text-base font-bold text-white">All Monitored Services</h2>
                <p class="text-xs text-zinc-400">Live statuses across all configured check types</p>
            </div>
            <a href="/admin/checks" class="text-xs font-mono text-emerald-400 hover:underline">Manage in Admin →</a>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead>
                    <tr class="border-b border-zinc-800 text-zinc-500 font-mono">
                        <th class="pb-3">Service Name</th>
                        <th class="pb-3">Type</th>
                        <th class="pb-3">Target</th>
                        <th class="pb-3">Latency / Response</th>
                        <th class="pb-3">Group</th>
                        <th class="pb-3 text-right">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-zinc-800/50">
                    {% for check in allChecks %}
                        <tr id="row-{{ check.id }}" class="hover:bg-zinc-800/20 transition duration-300">
                            <td class="py-3.5 font-semibold text-white">
                                {{ check.name }}
                                <div class="text-[10px] text-zinc-500 font-normal">{{ check.config.provider|default('Anycast') }}</div>
                            </td>
                            <td class="py-3.5 font-mono">
                                <span class="px-2 py-0.5 rounded text-[10px] uppercase font-bold {% if check.type == 'uplink' %}bg-emerald-500/10 text-emerald-400 border border-emerald-500/20{% else %}bg-blue-500/10 text-blue-400 border border-blue-500/20{% endif %}">
                                    {{ check.type }}
                                </span>
                            </td>
                            <td class="py-3.5 font-mono text-zinc-300">{{ check.config.url|default(check.config.host|default('-')) }}</td>
                            <td class="py-3.5 font-mono text-white font-bold">
                                <span id="lat-{{ check.id }}">
                                    {% if check.lastMetrics.avg_latency_ms is defined and check.lastMetrics.avg_latency_ms is not null %}
                                        {{ check.lastMetrics.avg_latency_ms|round(1) }} ms
                                    {% elseif check.lastMetrics.duration_ms is defined and check.lastMetrics.duration_ms is not null %}
                                        {{ check.lastMetrics.duration_ms|round(1) }} ms
                                    {% else %}
                                        -
                                    {% endif %}
                                </span>
                            </td>
                            <td class="py-3.5 text-zinc-400">{{ check.groupName }}</td>
                            <td id="badge-{{ check.id }}" class="py-3.5 text-right">
                                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase {% if check.status.value == 'excellent' or check.status.value == 'good' %}bg-emerald-500/15 text-emerald-400 border border-emerald-500/30{% else %}bg-amber-500/15 text-amber-400 border border-amber-500/30{% endif %}">
                                    {{ ('state.' ~ check.status.value)|trans }}
                                </span>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const stateLabels = {{ stateTranslations|json_encode|raw }};
    const uiText = {{ uiTranslations|json_encode|raw }};
    let eventSource = null;
    let isManuallyPaused = false;
    let fallbackTimer = null;

    function updateIfChanged(el, newContent, isHtml = false) {
        if (!el) return;
        const current = (isHtml ? el.innerHTML : el.textContent).trim();
        const incoming = String(newContent).trim();

        if (current !== incoming) {
            if (isHtml) {
                el.innerHTML = newContent;
            } else {
                el.textContent = newContent;
            }
            el.classList.remove('live-updated');
            void el.offsetWidth;
            el.classList.add('live-updated');
        }
    }

    function connectSSE() {
        if (isManuallyPaused || document.hidden) return;
        const dot = document.getElementById('connection-dot');
        const text = document.getElementById('connection-text');

        try {
            if (eventSource) eventSource.close();
            eventSource = new EventSource('/api/v1/uplink/stream?interval=3&packets=2');

            eventSource.addEventListener('open', () => {
                dot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
                text.textContent = uiText.live_sse || 'LIVE SSE STREAM';
                text.className = 'text-emerald-400 font-bold';
            });

            eventSource.addEventListener('update', (event) => {
                if (isManuallyPaused || document.hidden) return;
                try {
                    const data = JSON.parse(event.data);
                    updateDOM(data);
                } catch (err) {
                    console.error('Error parsing SSE payload', err);
                }
            });

            eventSource.onerror = () => {
                if (document.hidden) return;
                dot.className = 'w-2 h-2 rounded-full bg-amber-500';
                text.textContent = uiText.fallback_polling || 'FALLBACK POLLING';
                text.className = 'text-amber-400 font-bold';
                eventSource.close();
                if (!fallbackTimer && !document.hidden) {
                    fallbackTimer = setInterval(pollFallback, 3000);
                }
            };
        } catch (e) {
            console.error('SSE initialization error', e);
        }
    }

    function disconnectSSE(reason = null) {
        const dot = document.getElementById('connection-dot');
        const text = document.getElementById('connection-text');

        if (eventSource) {
            eventSource.close();
            eventSource = null;
        }
        if (fallbackTimer) {
            clearInterval(fallbackTimer);
            fallbackTimer = null;
        }

        dot.className = 'w-2 h-2 rounded-full bg-zinc-600';
        text.textContent = reason || uiText.paused || 'PAUSED';
        text.className = 'text-zinc-500 font-bold';
    }

    document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
            disconnectSSE(uiText.idle_background || 'IDLE (TAB IN BACKGROUND)');
        } else {
            if (!isManuallyPaused) {
                connectSSE();
                triggerImmediateProbe();
            }
        }
    });

    async function pollFallback() {
        if (isManuallyPaused || document.hidden) return;
        try {
            const statusRes = await fetch('/api/v1/uplink');
            const statusData = await statusRes.json();
            updateDOM({ summary: statusData.data, timestamp: new Date().toISOString() });
        } catch (err) {
            console.error('Fallback poll error', err);
        }
    }

    function updateDOM(payload) {
        const summary = payload.summary;
        if (!summary) return;

        updateIfChanged(document.getElementById('hero-score'), summary.health_score);
        updateIfChanged(document.getElementById('vital-latency'), summary.metrics.avg_latency_ms + ' ms');
        updateIfChanged(document.getElementById('vital-loss'), summary.metrics.avg_packet_loss_percent + '%');
        updateIfChanged(document.getElementById('vital-jitter'), '±' + summary.metrics.avg_jitter_ms + ' ms');

        const time = new Date(summary.evaluated_at);
        updateIfChanged(document.getElementById('hero-evaluated-time'), time.toLocaleTimeString());

        if (summary.targets) {
            summary.targets.forEach(t => {
                const latEl = document.getElementById('lat-' + t.target_id);
                const badgeEl = document.getElementById('badge-' + t.target_id);

                if (latEl) {
                    const newLat = t.avg_latency_ms !== null ? t.avg_latency_ms + ' ms' : 'DOWN';
                    updateIfChanged(latEl, newLat);
                }

                if (badgeEl) {
                    const isGood = t.state === 'excellent' || t.state === 'good';
                    const badgeStateText = stateLabels[t.state] || t.state;
                    const newBadgeHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${isGood ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/15 text-amber-400 border border-amber-500/30'}">${badgeStateText}</span>`;
                    updateIfChanged(badgeEl, newBadgeHtml, true);
                }
            });
        }
    }

    function toggleLiveStream() {
        const btn = document.getElementById('toggle-live-btn');
        if (isManuallyPaused) {
            isManuallyPaused = false;
            btn.textContent = uiText.pause || 'Pause';
            connectSSE();
        } else {
            isManuallyPaused = true;
            btn.textContent = uiText.resume || 'Resume';
            disconnectSSE(uiText.paused || 'PAUSED');
        }
    }

    async function triggerImmediateProbe() {
        const btn = document.getElementById('probe-btn');
        btn.disabled = true;
        btn.innerHTML = 'Probing...';
        try {
            await fetch('/api/v1/uplink/ping', { method: 'POST' });
            await fetch('/api/v1/http/check', { method: 'POST' });
            window.location.reload();
        } catch (e) {
            alert('Probe error: ' + e);
        } finally {
            btn.disabled = false;
            btn.innerHTML = 'Probe All Services';
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        if (!document.hidden) connectSSE();
    });
</script>
{% endblock %}
