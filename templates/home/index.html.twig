<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Homelab Uplink Status — Live API & Monitor</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        code, pre, .font-mono { font-family: 'JetBrains Mono', monospace; }
        
        .blur-ip {
            filter: blur(5px);
            transition: filter 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            user-select: none;
        }
        .blur-ip:hover {
            filter: blur(0);
            user-select: text;
        }

        @keyframes pulse-highlight {
            0% {
                background-color: rgba(16, 185, 129, 0.25);
                color: #34d399;
                border-radius: 4px;
            }
            100% {
                background-color: transparent;
            }
        }
        .live-updated {
            animation: pulse-highlight 0.9s ease-out;
        }
    </style>
</head>
<body class="bg-zinc-950 text-zinc-100 min-h-screen flex flex-col antialiased selection:bg-emerald-500 selection:text-white">
    <!-- Header -->
    <header class="border-b border-zinc-800/80 bg-zinc-900/60 backdrop-blur sticky top-0 z-50">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
                <div>
                    <span class="font-bold text-lg text-white tracking-tight">Homelab <span class="text-emerald-400">Uplink</span></span>
                    <span class="text-[10px] uppercase font-mono px-2 py-0.5 ml-2 bg-zinc-800 text-zinc-400 rounded-md border border-zinc-700">API-First</span>
                </div>
            </div>

            <div class="flex items-center gap-3 text-xs font-mono">
                <!-- IP Address (Blurred by default, hover to reveal) -->
                <div class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-zinc-900 border border-zinc-800 text-zinc-400 text-xs" title="Hover to reveal IP address">
                    <span class="text-zinc-500 font-sans text-[11px]">IP:</span>
                    <span class="blur-ip font-mono text-zinc-200 font-semibold cursor-pointer px-1 py-0.5 bg-zinc-950/80 rounded border border-zinc-800/60">
                        {{ clientIp|default('127.0.0.1') }}
                    </span>
                </div>

                <!-- Live indicator -->
                <div id="connection-badge" class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-zinc-900 border border-zinc-800 text-zinc-400">
                    <span id="connection-dot" class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="connection-text">CONNECTING...</span>
                </div>

                <button id="toggle-live-btn" onclick="toggleLiveStream()" class="px-2.5 py-1.5 rounded-lg border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[11px] font-semibold transition">
                    Pause
                </button>

                <a href="/api/v1/uplink" target="_blank" class="hidden sm:inline-block px-3 py-1.5 rounded-lg border border-emerald-500/30 bg-emerald-500/10 text-emerald-300 hover:bg-emerald-500/20 transition">
                    JSON API ↗
                </a>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8 space-y-8">
        <!-- Live Uplink Summary Card -->
        <div id="hero-card" class="rounded-2xl p-6 sm:p-8 border transition-all duration-500 {% if status.state.value == 'excellent' or status.state.value == 'good' %}bg-gradient-to-br from-emerald-950/40 via-zinc-900/50 to-zinc-900 border-emerald-500/30{% elseif status.state.value == 'degraded' %}bg-gradient-to-br from-amber-950/40 via-zinc-900/50 to-zinc-900 border-amber-500/30{% else %}bg-gradient-to-br from-rose-950/40 via-zinc-900/50 to-zinc-900 border-rose-500/30{% endif %}">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex items-center gap-4">
                    <div id="hero-icon" class="w-14 h-14 rounded-2xl flex items-center justify-center border shadow-lg {% if status.state.value == 'excellent' or status.state.value == 'good' %}bg-emerald-500/20 text-emerald-400 border-emerald-500/40{% elseif status.state.value == 'degraded' %}bg-amber-500/20 text-amber-400 border-amber-500/40{% else %}bg-rose-500/20 text-rose-400 border-rose-500/40{% endif %}">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h1 id="hero-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Uplink {{ status.state.label() }}</h1>
                            <span id="hero-state-badge" class="px-2.5 py-0.5 text-xs font-semibold rounded-full uppercase {% if status.state.value == 'excellent' or status.state.value == 'good' %}bg-emerald-500/20 text-emerald-400 border border-emerald-500/30{% else %}bg-amber-500/20 text-amber-400 border border-amber-500/30{% endif %}">
                                {{ status.state.value }}
                            </span>
                        </div>
                        <p class="text-sm text-zinc-400 mt-1">
                            Probed <span id="hero-targets-count">{{ status.healthyTargetsCount }} of {{ status.activeTargetsCount }}</span> external upstream target resolvers • Evaluated <span id="hero-evaluated-time" class="font-mono text-zinc-300">{{ status.evaluatedAt|date('H:i:s T') }}</span>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-4">
                    <div class="bg-zinc-950/60 border border-zinc-800 px-4 py-3 rounded-xl text-center">
                        <div class="text-[10px] uppercase font-mono text-zinc-400 font-semibold">Health Score</div>
                        <div class="text-2xl font-mono font-bold text-emerald-400"><span id="hero-score">{{ status.healthScore }}</span><span class="text-xs text-zinc-500">/100</span></div>
                    </div>
                    <button onclick="triggerImmediateProbe()" id="probe-btn" class="px-4 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs rounded-xl transition flex items-center gap-2 shadow-lg shadow-emerald-950">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                        Ping Now
                    </button>
                </div>
            </div>

            <!-- Vitals Row -->
            <div class="grid grid-cols-3 gap-3 mt-6 pt-6 border-t border-zinc-800/60">
                <div class="bg-zinc-950/40 p-3 rounded-xl border border-zinc-800/60 text-center">
                    <span class="text-[11px] text-zinc-400">Average RTT Latency</span>
                    <div id="vital-latency" class="text-lg font-mono font-bold text-white mt-0.5">{{ status.avgLatencyMs|round(1) }} ms</div>
                </div>
                <div class="bg-zinc-950/40 p-3 rounded-xl border border-zinc-800/60 text-center">
                    <span class="text-[11px] text-zinc-400">Average Packet Loss</span>
                    <div id="vital-loss" class="text-lg font-mono font-bold {% if status.avgPacketLossPercent == 0 %}text-emerald-400{% else %}text-amber-400{% endif %} mt-0.5">
                        {{ status.avgPacketLossPercent|round(1) }}%
                    </div>
                </div>
                <div class="bg-zinc-950/40 p-3 rounded-xl border border-zinc-800/60 text-center">
                    <span class="text-[11px] text-zinc-400">Average Jitter</span>
                    <div id="vital-jitter" class="text-lg font-mono font-bold text-white mt-0.5">±{{ status.avgJitterMs|round(2) }} ms</div>
                </div>
            </div>
        </div>

        <!-- Target Probes Table with Sparklines -->
        <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-base font-bold text-white">External Target Probes & Historical Sparklines</h2>
                <div class="flex items-center gap-2 text-xs font-mono text-zinc-500">
                    <span class="w-2 h-2 rounded-full bg-emerald-500/80"></span>
                    <span>Live SSE Stream</span>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="border-b border-zinc-800 text-zinc-500 font-mono">
                            <th class="pb-3">Target Node</th>
                            <th class="pb-3">Host IP</th>
                            <th class="pb-3">Latency</th>
                            <th class="pb-3">Jitter</th>
                            <th class="pb-3">Loss</th>
                            <th class="pb-3">Latency Sparkline</th>
                            <th class="pb-3 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody id="targets-tbody" class="divide-y divide-zinc-800/50">
                        {% for targetRes in status.targets %}
                            {% set tInfo = history.targets[targetRes.targetId]|default(null) %}
                            <tr id="row-{{ targetRes.targetId }}" class="hover:bg-zinc-800/20 transition duration-300">
                                <td class="py-3 font-semibold text-white">
                                    {{ tInfo.target.name|default(targetRes.targetId) }}
                                    <div class="text-[10px] text-zinc-500 font-normal">{{ tInfo.target.provider|default('Anycast') }}</div>
                                </td>
                                <td class="py-3 font-mono text-zinc-300">{{ targetRes.host }}</td>
                                <td class="py-3 font-mono text-white font-bold"><span id="lat-{{ targetRes.targetId }}">{{ targetRes.avgLatencyMs|round(1) }} ms</span></td>
                                <td class="py-3 font-mono text-zinc-400"><span id="jit-{{ targetRes.targetId }}">±{{ targetRes.jitterMs|round(1) }} ms</span></td>
                                <td class="py-3 font-mono"><span id="loss-{{ targetRes.targetId }}" class="{% if targetRes.packetLossPercent == 0 %}text-emerald-400{% else %}text-rose-400{% endif %}">{{ targetRes.packetLossPercent|round(0) }}%</span></td>
                                <td class="py-3 font-mono text-emerald-400 text-sm tracking-widest"><span id="spark-{{ targetRes.targetId }}">{{ tInfo.sparkline|default('────────') }}</span></td>
                                <td id="badge-{{ targetRes.targetId }}" class="py-3 text-right">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase {% if targetRes.state.value == 'excellent' or targetRes.state.value == 'good' %}bg-emerald-500/15 text-emerald-400 border border-emerald-500/30{% else %}bg-amber-500/15 text-amber-400 border border-amber-500/30{% endif %}">
                                        {{ targetRes.state.value }}
                                    </span>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Terminal User Interface (TUI) Notice -->
        <div class="bg-zinc-900/60 border border-zinc-800/80 rounded-2xl p-6">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h3 class="text-base font-bold text-white flex items-center gap-2">
                        <span class="font-mono text-emerald-400">$</span>
                        Terminal User Interface (TUI)
                    </h3>
                    <p class="text-xs text-zinc-400 mt-1">Run an interactive live updating terminal dashboard on your server or SSH session.</p>
                </div>
                <code class="bg-zinc-950 border border-zinc-800 px-3.5 py-2 rounded-xl text-xs text-emerald-400 font-mono">
                    php bin/console uplink:tui
                </code>
            </div>
        </div>
    </main>

    <!-- Client-side SSE Live Update Engine with Granular Flashing -->
    <script>
        let eventSource = null;
        let isManuallyPaused = false;
        let fallbackTimer = null;

        // Helper: Updates an element only if its content changed, and flashes only that specific element
        function updateIfChanged(el, newContent, isHtml = false) {
            if (!el) return;
            const current = (isHtml ? el.innerHTML : el.textContent).trim();
            const incoming = String(newContent).trim();

            if (current !== incoming) {
                if (isHtml) {
                    el.innerHTML = newContent;
                } else {
                    el.textContent = newContent;
                }
                el.classList.remove('live-updated');
                void el.offsetWidth; // trigger reflow
                el.classList.add('live-updated');
            }
        }

        function connectSSE() {
            if (isManuallyPaused || document.hidden) return;

            const dot = document.getElementById('connection-dot');
            const text = document.getElementById('connection-text');

            try {
                if (eventSource) {
                    eventSource.close();
                }

                eventSource = new EventSource('/api/v1/uplink/stream?interval=3&packets=2');

                eventSource.addEventListener('open', () => {
                    dot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
                    text.textContent = 'LIVE SSE STREAM';
                    text.className = 'text-emerald-400 font-bold';
                });

                eventSource.addEventListener('update', (event) => {
                    if (isManuallyPaused || document.hidden) return;
                    try {
                        const data = JSON.parse(event.data);
                        updateDOM(data);
                    } catch (err) {
                        console.error('Error parsing SSE payload', err);
                    }
                });

                eventSource.onerror = () => {
                    if (document.hidden) return;
                    dot.className = 'w-2 h-2 rounded-full bg-amber-500';
                    text.textContent = 'FALLBACK POLLING';
                    text.className = 'text-amber-400 font-bold';
                    eventSource.close();
                    if (!fallbackTimer && !document.hidden) {
                        fallbackTimer = setInterval(pollFallback, 3000);
                    }
                };
            } catch (e) {
                console.error('SSE initialization error', e);
                if (!fallbackTimer && !document.hidden) {
                    fallbackTimer = setInterval(pollFallback, 3000);
                }
            }
        }

        function disconnectSSE(reason = 'PAUSED') {
            const dot = document.getElementById('connection-dot');
            const text = document.getElementById('connection-text');

            if (eventSource) {
                eventSource.close();
                eventSource = null;
            }
            if (fallbackTimer) {
                clearInterval(fallbackTimer);
                fallbackTimer = null;
            }

            dot.className = 'w-2 h-2 rounded-full bg-zinc-600';
            text.textContent = reason;
            text.className = 'text-zinc-500 font-bold';
        }

        // Tab visibility listener: only keep connection alive when tab is actively focused
        document.addEventListener('visibilitychange', () => {
            if (document.hidden) {
                disconnectSSE('IDLE (TAB IN BACKGROUND)');
            } else {
                if (!isManuallyPaused) {
                    connectSSE();
                    triggerImmediateProbe(); // Immediate refresh when user switches back to tab
                }
            }
        });

        async function pollFallback() {
            if (isManuallyPaused || document.hidden) return;
            try {
                const res = await fetch('/api/v1/uplink/history?samples=20');
                const statusRes = await fetch('/api/v1/uplink');
                const historyData = await res.json();
                const statusData = await statusRes.json();

                updateDOM({
                    summary: statusData.data,
                    history: historyData.data,
                    timestamp: new Date().toISOString()
                });
            } catch (err) {
                console.error('Fallback poll error', err);
            }
        }

        function updateDOM(payload) {
            const summary = payload.summary;
            const history = payload.history;

            // 1. Hero Card
            updateIfChanged(document.getElementById('hero-title'), 'Uplink ' + (summary.state_label || summary.state));
            
            const stateBadge = document.getElementById('hero-state-badge');
            if (stateBadge) {
                updateIfChanged(stateBadge, summary.state);
                if (summary.state === 'excellent' || summary.state === 'good') {
                    stateBadge.className = 'px-2.5 py-0.5 text-xs font-semibold rounded-full uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30';
                } else {
                    stateBadge.className = 'px-2.5 py-0.5 text-xs font-semibold rounded-full uppercase bg-amber-500/20 text-amber-400 border border-amber-500/30';
                }
            }

            updateIfChanged(document.getElementById('hero-score'), summary.health_score);
            updateIfChanged(document.getElementById('hero-targets-count'), `${summary.targets_summary.healthy} of ${summary.targets_summary.total}`);
            
            const time = new Date(summary.evaluated_at);
            document.getElementById('hero-evaluated-time').textContent = time.toLocaleTimeString();

            // 2. Vitals
            updateIfChanged(document.getElementById('vital-latency'), summary.metrics.avg_latency_ms + ' ms');
            updateIfChanged(document.getElementById('vital-loss'), summary.metrics.avg_packet_loss_percent + '%');
            updateIfChanged(document.getElementById('vital-jitter'), '±' + summary.metrics.avg_jitter_ms + ' ms');

            // 3. Targets Table (Flash ONLY individual cells that actually changed)
            if (summary.targets && summary.targets.length > 0) {
                summary.targets.forEach(t => {
                    const latEl = document.getElementById('lat-' + t.target_id);
                    const jitEl = document.getElementById('jit-' + t.target_id);
                    const lossEl = document.getElementById('loss-' + t.target_id);
                    const sparkEl = document.getElementById('spark-' + t.target_id);
                    const badgeEl = document.getElementById('badge-' + t.target_id);

                    if (latEl) {
                        const newLat = t.avg_latency_ms !== null ? t.avg_latency_ms + ' ms' : 'DOWN';
                        updateIfChanged(latEl, newLat);
                    }

                    if (jitEl) {
                        const newJit = t.jitter_ms !== null ? '±' + t.jitter_ms + ' ms' : '-';
                        updateIfChanged(jitEl, newJit);
                    }

                    if (lossEl) {
                        const newLoss = t.packet_loss_percent + '%';
                        updateIfChanged(lossEl, newLoss);
                        lossEl.className = 'transition ' + (t.packet_loss_percent === 0 ? 'text-emerald-400' : 'text-rose-400');
                    }

                    if (history && history.targets && history.targets[t.target_id] && sparkEl) {
                        updateIfChanged(sparkEl, history.targets[t.target_id].sparkline);
                    }

                    if (badgeEl) {
                        const isGood = t.state === 'excellent' || t.state === 'good';
                        const newBadgeHtml = `<span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase ${isGood ? 'bg-emerald-500/15 text-emerald-400 border border-emerald-500/30' : 'bg-amber-500/15 text-amber-400 border border-amber-500/30'}">${t.state}</span>`;
                        updateIfChanged(badgeEl, newBadgeHtml, true);
                    }
                });
            }
        }

        function toggleLiveStream() {
            const btn = document.getElementById('toggle-live-btn');

            if (isManuallyPaused) {
                isManuallyPaused = false;
                btn.textContent = 'Pause';
                connectSSE();
            } else {
                isManuallyPaused = true;
                btn.textContent = 'Resume';
                disconnectSSE('PAUSED');
            }
        }

        async function triggerImmediateProbe() {
            const btn = document.getElementById('probe-btn');
            btn.disabled = true;
            btn.innerHTML = 'Pinging...';
            try {
                const res = await fetch('/api/v1/uplink/ping', { method: 'POST' });
                const json = await res.json();
                if (json.data) {
                    const histRes = await fetch('/api/v1/uplink/history?samples=20');
                    const histJson = await histRes.json();
                    updateDOM({
                        summary: json.data,
                        history: histJson.data,
                        timestamp: new Date().toISOString()
                    });
                }
            } catch (e) {
                console.error('Probe error', e);
            } finally {
                btn.disabled = false;
                btn.innerHTML = 'Ping Now';
            }
        }

        // Start SSE on initial page load if visible
        window.addEventListener('DOMContentLoaded', () => {
            if (!document.hidden) {
                connectSSE();
            }
        });
    </script>
</body>
</html>
